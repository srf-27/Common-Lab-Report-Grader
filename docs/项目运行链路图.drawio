          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ===== 右侧说明列（模块/输入输出） ===== -->
        <mxCell id="d1" value="页面：rubric_review.html&lt;br&gt;路由：/upload_criteria、/process_criteria&lt;br&gt;输入：评分标准 .txt/.md/.pdf/.docx" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;align=left;spacingLeft=10;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="430" y="40" width="470" height="56" as="geometry" />
        </mxCell>
        <mxCell id="d2" value="模块：nodes/rubric_generator.py&lt;br&gt;调用：utils/llm_client.py（LLM 生成结构化细则）&lt;br&gt;输出：Rubric 表格（维度/权重/等级描述）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;align=left;spacingLeft=10;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="430" y="136" width="470" height="56" as="geometry" />
        </mxCell>
        <mxCell id="d3" value="存储：data/output/sessions/&lt;课程ID&gt;/rubrics/&lt;br&gt;模块：nodes/rubric_io.py（权重归一化/读写）&lt;br&gt;（可选）校准模式：教师打分 vs AI 打分" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;align=left;spacingLeft=10;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="430" y="232" width="470" height="56" as="geometry" />
        </mxCell>
        <mxCell id="d4" value="页面：reports_list.html&lt;br&gt;路由：/upload_reports、/process_reports&lt;br&gt;输入：学生报告 PDF/DOCX/压缩包（自动去重）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;align=left;spacingLeft=10;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="430" y="328" width="470" height="56" as="geometry" />
        </mxCell>
        <mxCell id="d5" value="模块：nodes/report_extractor.py&lt;br&gt;调用：utils/file_parser.py、utils/ocr_engine.py&lt;br&gt;输出：text.md 提取文本 + images/ 图片" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;align=left;spacingLeft=10;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="430" y="424" width="470" height="56" as="geometry" />
        </mxCell>
        <mxCell id="d6" value="模块：nodes/grader.py（LLM 逐维度评级）&lt;br&gt;辅助：nodes/verifier.py（机械判定）、utils/injection_detector.py、content_safety.py、similarity.py&lt;br&gt;输出：grading_results.json" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;align=left;spacingLeft=10;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="430" y="520" width="470" height="56" as="geometry" />
        </mxCell>
        <mxCell id="d7" value="页面：review_batch.html、grading_done.html&lt;br&gt;路由：/approve_batch、/update_scores、/regrade&lt;br&gt;操作：教师修改等级/评语、查看原文" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;align=left;spacingLeft=10;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="430" y="616" width="470" height="56" as="geometry" />
        </mxCell>
        <mxCell id="d8" value="模块：utils/privacy.py（脱敏姓名/学号等）&lt;br&gt;模块：embedding/chroma.py（写入会话级 kb_db）&lt;br&gt;结果：优秀案例成为 RAG 参考" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;align=left;spacingLeft=10;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="430" y="712" width="470" height="56" as="geometry" />
        </mxCell>
        <mxCell id="d9" value="模块：nodes/agreement.py（Cohen's Kappa 一致性）&lt;br&gt;导出：/download（Excel 汇总表 / 评分 JSON）&lt;br&gt;输出：Kappa 报告 / 基准评测" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;align=left;spacingLeft=10;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="430" y="808" width="470" height="56" as="geometry" />
        </mxCell>

