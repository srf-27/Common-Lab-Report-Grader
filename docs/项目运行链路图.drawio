<mxfile host="app.diagrams.net" agent="Experiment-Report-Grader" version="24.0.0">
  <diagram id="experiment-report-grader-flow" name="项目运行链路图">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="980" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- 标题 -->
        <mxCell id="title" value="实验报告智能评分系统 · 运行链路图" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=18;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="380" y="5" width="440" height="30" as="geometry" />
        </mxCell>

        <!-- ===== 主流程节点（左列，纵向） ===== -->
        <mxCell id="s1" value="① 上传评分标准文档" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fe;strokeColor=#4285f4;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="60" y="40" width="280" height="56" as="geometry" />
        </mxCell>
        <mxCell id="s2" value="② 生成评分细则（Rubric）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fe;strokeColor=#4285f4;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="60" y="136" width="280" height="56" as="geometry" />
        </mxCell>
        <mxCell id="s3" value="③ 保存细则到会话" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fe;strokeColor=#4285f4;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="60" y="232" width="280" height="56" as="geometry" />
        </mxCell>
        <mxCell id="s4" value="④ 上传学生报告" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fe;strokeColor=#4285f4;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="60" y="328" width="280" height="56" as="geometry" />
        </mxCell>
        <mxCell id="s5" value="⑤ 提取文本 / 图片（OCR）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f0fe;strokeColor=#4285f4;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="60" y="424" width="280" height="56" as="geometry" />
        </mxCell>
        <mxCell id="s6" value="⑥ 逐维度评分" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef7e0;strokeColor=#f9ab00;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="60" y="520" width="280" height="56" as="geometry" />
        </mxCell>
        <mxCell id="s7" value="⑦ 批次审查 · 教师修正" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef7e0;strokeColor=#f9ab00;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="60" y="616" width="280" height="56" as="geometry" />
        </mxCell>
        <mxCell id="s8" value="⑧ 终审 · 脱敏入 RAG" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e8fd;strokeColor=#7b1fa2;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="60" y="712" width="280" height="56" as="geometry" />
        </mxCell>
        <mxCell id="s9" value="⑨ 导出结果 · 一致性分析" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e8fd;strokeColor=#7b1fa2;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="60" y="808" width="280" height="56" as="geometry" />
        </mxCell>

        <!-- ===== 主流程箭头（纵向） ===== -->
        <mxCell id="a1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2;strokeColor=#4285f4;" edge="1" parent="1" source="s1" target="s2">
          <mxGeometry relative="1" as="geometry" />
