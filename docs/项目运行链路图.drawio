        <mxCell id="cap2grade" value="挂载到 LLM 节点" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;dashed=1;strokeWidth=2;strokeColor=#f9ab00;fontSize=10;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="dl3" target="d7">
