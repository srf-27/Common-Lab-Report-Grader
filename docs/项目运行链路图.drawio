        <mxCell id="dlab" value="数据层 · 模型 · 能力源" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontStyle=1;spacingLeft=10;" vertex="1" parent="1">
