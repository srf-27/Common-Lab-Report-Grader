        <mxCell id="dl4" value="外部服务&lt;br&gt;LLM（OpenAI / Ollama / custom）· OCR&lt;br&gt;Chroma 向量库 · 可选 PostgreSQL" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f4ea;strokeColor=#34a853;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="980" y="396" width="240" height="92" as="geometry" />
