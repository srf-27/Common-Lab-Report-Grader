          <mxGeometry x="980" y="228" width="240" height="64" as="geometry" />
        </mxCell>
        <mxCell id="dl3" value="可插拔能力源&lt;br&gt;utils/calc_tools · skills 技能包 · mcp 工具" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef7e0;strokeColor=#f9ab00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="980" y="308" width="240" height="72" as="geometry" />
